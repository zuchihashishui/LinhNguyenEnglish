# --- Chế độ dữ liệu ---
# Đặt USE_MOCK=1 để chạy với dữ liệu giả lập (in-memory) - KHÔNG cần MySQL.
# Dùng chế độ này để xem giao diện web ngay khi chưa cài MySQL.
# Để trống hoặc =0 để dùng MySQL thật.
USE_MOCK=1

# --- Cấu hình MySQL (chỉ dùng khi USE_MOCK=0) ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=linh_english_attendance

# --- Server ---
PORT=3000
